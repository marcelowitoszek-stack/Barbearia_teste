# =============================================================================
# O INSTALADOR CRIA ESTE ARQUIVO SOZINHO (como .env). Voce nao precisa editar.
# Nome da barbearia, atendente, WhatsApp do barbeiro e chave do Gemini tambem
# podem ser alterados depois pelo painel: http://localhost:3737
# =============================================================================

# --- Gemini (https://aistudio.google.com/apikey) -----------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Barbearia (valores iniciais; o painel sobrepoe) -------------------------
EMPRESA_NOME=Minha Barbearia
EMPRESA_CIDADE=
ATENDENTE_NOME=Alex
# Opcionais. Vazio e melhor que errado: sem eles o agente nao inventa.
EMPRESA_ENDERECO=
EMPRESA_HORARIO=
# WhatsApp que recebe o pedido pronto (55 + DDD + numero). Ex: 5511999998888
HUMANO_WHATSAPP=
TIMEZONE=America/Sao_Paulo

# --- Google Agenda (opcional; mais facil configurar pelo painel) ----------
# Coloque a chave .json da conta de servico na pasta dados/ e compartilhe a
# agenda com o e-mail dela ("Fazer alteracoes nos eventos").
AGENDA_ID=
# HORA_ABERTURA=09:00
# HORA_FECHAMENTO=19:00
# ALMOCO_INICIO=
# ALMOCO_FIM=
# 0=domingo ... 6=sabado
# DIAS_FUNCIONAMENTO=1,2,3,4,5,6
# INTERVALO_MIN=30
# ATENDIMENTOS_SIMULTANEOS=1
# ANTECEDENCIA_MIN=60

# --- Segredos gerados pelo instalador (NAO compartilhe) ----------------------
EVOLUTION_API_KEY=
WEBHOOK_SECRET=
POSTGRES_SENHA=
EVOLUTION_INSTANCIA=barbearia

# --- Portas neste computador (troque se ja estiverem em uso) -----------------
PAINEL_PORTA=3737
EVOLUTION_PORTA=8787

# --- Opcional: enviar cada pedido em JSON para n8n/Make/Zapier/planilha ------
LEAD_WEBHOOK_URL=

# --- Comportamento (tem padrao para tudo; so mexa se precisar) ---------------
# TEMPERATURA=0.7
# MAX_OUTPUT_TOKENS=400
# DEBOUNCE_MS=6000
# ENTENDER_AUDIO=true
# PAUSAR_APOS_LEAD=true
# PAUSA_APOS_LEAD_MIN=120
# PAUSA_HUMANO_MIN=60
# HUMANIZAR=true
# SESSAO_TTL_MS=7200000
# MAX_HISTORICO=24
